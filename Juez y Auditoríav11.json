      "id": "5afefd87-f131-47d6-853c-092d9b712c3a",
      "name": "Entrada desde Orquestador",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        112
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Actúa como un asistente de una inmobiliaria. Analiza el siguiente correo y extrae la información en formato JSON estricto.\n\nLas claves del JSON deben ser exactamente estas:\n- \"DNI\": (string o null si no aparece)\n- \"Nombre\": (string o null)\n- \"Fecha\": (string en formato YYYY-MM-DD o null)\n- \"Hora\": (string en formato HH:MM o null)\n- \"Presupuesto\": (solo el número, sin símbolos, o null)\n- \"Email\": (string o null si no aparece)\n- \"Telefono\": (string o null si no aparece)\n- \"Intencion\": (string, debe ser EXACTAMENTE una de estas 4 palabras: 'Alquilar', 'Vender', 'Ver', 'Consulta').\n- \"Confianza\": (número decimal entre 0.0 y 1.0 que indique la certeza del análisis)\n- \"Razonamiento_Extractor\": (breve explicación de 1 frase de por qué elegiste esta intención)\n\nCorreo a analizar:\n{{ $json.snippet }}",
        "batching": {}
      },
      "id": "fbd56600-8163-407a-a773-09f9a6482d36",
      "name": "detecta solicitud",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        224,
        112
      ]
    },
    {
      "parameters": {
        "model": "groq/compound-mini",
        "options": {}
      },
      "id": "c3367739-4858-4054-8e05-7643a13a79b1",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        224,
        352
      ],
      "credentials": {
        "groqApi": {
          "id": "F3Dx1Stan8p1NzFk",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const aiOutput = j.text ?? j.output ?? (j.message && j.message.content) ?? j.response ?? '';\n  try {\n    const cleanJson = String(aiOutput).replace(/```json\\n?|```\\n?/g, '').trim();\n    results.push({ json: { parsed_data: JSON.parse(cleanJson) } });\n  } catch (error) {\n    results.push({ json: { parsed_data: { error: 'No se pudo parsear el JSON de la IA', raw: String(aiOutput) } } });\n  }\n}\nreturn results;"
      },
      "id": "9c78f042-5d90-4e47-838e-cae61a6e68e8",
      "name": "Parsear JSON IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        112
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Solicitud ORIGINAL del cliente:\n{{ $('Entrada desde Orquestador').item.json.snippet }}\n\nEXTRACCIÓN DEL MODELO PRIMARIO:\n{{ JSON.stringify($json.parsed_data) }}",
        "messages": {
          "messageValues": [
            {
              "message": "Actúa como un Auditor de Calidad e Inteligencia Inmobiliaria (AI-as-a-Judge). Tu tarea es evaluar el análisis realizado por un modelo primario sobre una solicitud de un cliente.\n\nREGLAS DE AUDITORÍA:\n1. Verifica si la 'Intencion' asignada ('Alquilar', 'Vender', 'Ver', 'Consulta') corresponde de forma lógica y estricta al correo original.\n2. Detecta alucinaciones, datos faltantes o incongruencias.\n3. Si la intención del modelo primario es correcta, apruébala. Si es incorrecta o dudosa, corrígela.\n\nPUNTAJA CADA DIMENSIÓN DE 1 (muy malo) A 5 (excelente) según esta RÚBRICA JSON Schema:\n- exactitud_factual: ¿los datos extraídos coinciden exactamente con el correo, sin alucinaciones?\n- relevancia: ¿la extracción se centra en lo que el cliente realmente pidió?\n- completitud: ¿se capturaron todos los datos presentes en el correo?\n\nRESPONDE ÚNICAMENTE EN FORMATO JSON ESTRICTO (sin texto adicional, sin markdown):\n{\n  \"aprobado\": (true o false),\n  \"intencion_final\": (string: 'Alquilar', 'Vender', 'Ver' o 'Consulta'),\n  \"score_confianza\": (float entre 0.0 y 1.0),\n  \"rubrica\": {\n    \"exactitud_factual\": (entero 1-5),\n    \"relevancia\": (entero 1-5),\n    \"completitud\": (entero 1-5)\n  },\n  \"observaciones_juez\": (string con la justificación de tu dictamen)\n}"
            }
          ]
        },
        "batching": {}
      },
      "id": "6ba76f48-cc8e-4199-8518-987e2c36888b",
      "name": "AI-as-a-Judge Supervisor",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        784,
        112
      ]
    },
    {
      "parameters": {
        "model": "groq/compound-mini",
        "options": {}
      },
      "id": "22d7211d-f39f-4cb6-9417-81ac6b35bd3c",
      "name": "Groq Chat Model Juez",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        784,
        336
      ],
      "credentials": {
        "groqApi": {
          "id": "F3Dx1Stan8p1NzFk",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const aiOutput = j.text ?? j.output ?? (j.message && j.message.content) ?? j.response ?? '';\n  try {\n    const cleanJson = String(aiOutput).replace(/```json\\n?|```\\n?/g, '').trim();\n    results.push({ json: { judge_review: JSON.parse(cleanJson) } });\n  } catch (error) {\n    // Fallback de seguridad si el juez falla: congela autonomía\n    results.push({\n      json: {\n        judge_review: {\n          aprobado: false,\n          intencion_final: 'Consulta',\n          score_confianza: 0.0,\n          rubrica: { exactitud_factual: 1, relevancia: 1, completitud: 1 },\n          observaciones_juez: 'Error de parseo en el Juez AI. Se congela la autonomía.'\n        }\n      }\n    });\n  }\n}\nreturn results;"
      },
      "id": "087ac6a6-b34c-4d3b-91fe-3b5b10c6f279",
      "name": "Parsear JSON Judge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        112
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={\n  \"traceId\": {{ JSON.stringify($('Entrada desde Orquestador').item.json.traceId) }},\n  \"nombre\": {{ JSON.stringify($('Parsear JSON IA').item.json.parsed_data.Nombre ?? null) }},\n  \"consulta\": {{ JSON.stringify($('Entrada desde Orquestador').item.json.snippet ?? null) }},\n  \"extracted_data\": {{ JSON.stringify($('Parsear JSON IA').item.json.parsed_data) }},\n  \"governance\": {\n    \"juez_aprobado\": {{ $('Parsear JSON Judge').item.json.judge_review.aprobado ?? false }},\n    \"score_confianza\": {{ $('Parsear JSON Judge').item.json.judge_review.score_confianza ?? 0 }},\n    \"rubrica\": {{ JSON.stringify($('Parsear JSON Judge').item.json.judge_review.rubrica ?? {}) }},\n    \"observaciones\": {{ JSON.stringify($('Parsear JSON Judge').item.json.judge_review.observaciones_juez ?? null) }}\n  },\n  \"intencion_validada\": {{ JSON.stringify($('Parsear JSON Judge').item.json.judge_review.intencion_final ?? 'Consulta') }}\n}",
        "options": {}
